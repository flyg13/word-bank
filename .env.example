# Copy to .env for `netlify dev`. Never commit the real file.
# The key itself: https://platform.openai.com/api-keys — see README.
OPENAI_API_KEY=sk-replace-me

# Optional. Defaults are gpt-4o-transcribe and openai; see CLAUDE.md §9.
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_PROVIDER=openai

# Context-aware correction (CLAUDE.md §10). A Bedrock API key, from the AWS
# console in ap-southeast-2. Not AWS_-prefixed: Netlify reserves those names.
BEDROCK_API_KEY=bedrock-replace-me

# Optional. Defaults are ap-southeast-2, anthropic.claude-sonnet-5, bedrock-claude.
# BEDROCK_REGION=ap-southeast-2
# BEDROCK_MODEL=anthropic.claude-sonnet-5
# CONTEXT_PROVIDER=bedrock-claude
